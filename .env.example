# Supabase (required)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# OpenRouter (required for LLM)
# Multiple free keys as JSON list; paid fallback key optional
OPENROUTER_KEYS=[""]
OPENROUTER_PAID_KEY=

# Legacy Gemini fallback (optional)
GEMINI_API_KEY=

# LLM defaults
LLM_PROVIDER=openrouter
LLM_TEMPERATURE=0.1
MAX_OUTPUT_TOKENS=4096

# Whisper (audio transcription)
WHISPER_MODEL=base